# =============================================================================
# Personal AI Assistant — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# User profile — who this assistant serves
# -----------------------------------------------------------------------------
USER_NAME=Phil
USER_ID=phil
USER_EMAIL=philip@ayadata.ai
USER_JOB_TITLE=AI/ML Engineer
USER_COMPANY=AyaData

# -----------------------------------------------------------------------------
# AWS Bedrock
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Claude model for chat / generation
CLAUDE_MODEL_ID=anthropic.claude-sonnet-4-6-20250514-v1:0
# Titan for embeddings
TITAN_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# -----------------------------------------------------------------------------
# PostgreSQL (local Docker — see infra/docker-compose.yml)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://assistant:assistant@localhost:5433/assistant

# -----------------------------------------------------------------------------
# OAuth token encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
OAUTH_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Gmail OAuth 2.0
# Create credentials at: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# -----------------------------------------------------------------------------
# Transcription
# -----------------------------------------------------------------------------
ASSEMBLYAI_API_KEY=
TRANSCRIPTION_PROVIDER=assemblyai   # assemblyai | whisper
WHISPER_MODEL_SIZE=base             # tiny | base | small | medium | large-v2

# -----------------------------------------------------------------------------
# GitHub
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_ANALYZE_MAX_FILES=100
GITHUB_FILE_CONTENT_MAX_LENGTH=2000
GITHUB_ANALYZE_MAX_CONTEXT=12000
GITHUB_MAX_KEY_FILES=25

# -----------------------------------------------------------------------------
# Google Drive / Docs / Sheets
# -----------------------------------------------------------------------------
DRIVE_SEARCH_MAX_RESULTS=10
DEFAULT_DOC_TITLE=New Document
DEFAULT_SHEET_RANGE=Sheet1!A:Z

# -----------------------------------------------------------------------------
# Morning Brief
# -----------------------------------------------------------------------------
BRIEF_CRON_EXPRESSION=0 7 * * *
BRIEF_TIMEZONE=Africa/Lagos
BRIEF_DELIVERY_EMAIL=           # leave blank to disable email delivery
BRIEF_PRIORITY_EMAILS_LIMIT=10
BRIEF_ACTION_ITEMS_LIMIT=10
BRIEF_ROADMAPS_LIMIT=2
BRIEF_HABITS_LIMIT=3
BRIEF_INTERESTS_LIMIT=3
BRIEF_SKILL_GOALS_LIMIT=2

# -----------------------------------------------------------------------------
# Email module
# -----------------------------------------------------------------------------
EMAIL_THREADS_LIMIT=10
EMAIL_TRIAGE_LIMIT=10
EMAIL_POLL_MAX_RESULTS=20
EMAIL_SNIPPET_MAX_LENGTH=300
EMAIL_SUBJECT_DISPLAY_LENGTH=50
EMAIL_SUMMARIZE_LIMIT=5

# -----------------------------------------------------------------------------
# Meeting module
# -----------------------------------------------------------------------------
TRANSCRIPT_MAX_LENGTH=8000
TRANSCRIPT_DB_MAX_LENGTH=5000

# -----------------------------------------------------------------------------
# Orchestrator / intent classification
# -----------------------------------------------------------------------------
INTENT_CONFIDENCE_THRESHOLD=0.6
CONVERSATION_HISTORY_LIMIT=6

# -----------------------------------------------------------------------------
# Memory / RAG
# -----------------------------------------------------------------------------
MAX_MEMORY_ENTRIES_PER_QUERY=10
EMBEDDING_BATCH_SIZE=20
CONTEXT_MEMORY_LIMIT=5

# -----------------------------------------------------------------------------
# Learning Coach defaults
# -----------------------------------------------------------------------------
DEFAULT_EXPERIENCE_LEVEL=intermediate
DEFAULT_DAILY_MINUTES=60
DEFAULT_DURATION_WEEKS=12

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
